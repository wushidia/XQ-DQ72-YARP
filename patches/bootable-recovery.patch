@@ -994,0 +995,26 @@ static bool get_kernel_video_mode(uint32_t* width, uint32_t* height) {
+/* Select a mode without changing the requested resolution. Android's DRM
+ * mode list may mark a 60 Hz mode as preferred even when a 120 Hz mode is
+ * available at the same resolution. */
+static int choose_mode_for_resolution(const drmModeConnector* connector,
+        uint32_t width, uint32_t height) {
+    int preferred = -1;
+    int highest_refresh = -1;
+    int highest_refresh_index = -1;
+    for (int index = 0; index < connector->count_modes; ++index) {
+        const drmModeModeInfo& mode = connector->modes[index];
+        if (mode.hdisplay != width || mode.vdisplay != height)
+            continue;
+        if (mode.type & DRM_MODE_TYPE_PREFERRED)
+            preferred = index;
+        if (mode.vrefresh >= 119 && mode.vrefresh <= 121)
+            return index;
+        if (mode.vrefresh > highest_refresh) {
+            highest_refresh = mode.vrefresh;
+            highest_refresh_index = index;
+        }
+    }
+    if (highest_refresh_index >= 0 && highest_refresh > 0)
+        return highest_refresh_index;
+    return preferred;
+}
+
